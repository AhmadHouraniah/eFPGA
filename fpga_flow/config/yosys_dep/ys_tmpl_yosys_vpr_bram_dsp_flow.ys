# Yosys synthesis script for ${TOP_MODULE}

#########################
# Parse input files
#########################
read_verilog ${READ_VERILOG_OPTIONS} ${VERILOG_FILES}
read_verilog -lib -specify ${YOSYS_CELL_SIM_VERILOG}

#########################
# Prepare for synthesis
#########################
proc
hierarchy -top ${TOP_MODULE}
techmap -D NO_LUT -map +/adff2dff.v

flatten
proc
tribuf -logic
opt_expr
opt_clean
check
deminout
opt
wreduce
peepopt
opt_clean
share
opt_expr
opt_clean
memory -nomap
opt_clean
memory_libmap -lib ${YOSYS_BRAM_MAP_RULES}
techmap -map ${YOSYS_BRAM_MAP_VERILOG}
opt -fast -mux_undef -undriven -fine -nodffe -nosdff
memory_map
opt -undriven -fine -nodffe -nosdff
proc

#########################
# Map multipliers
#########################
memory_dff
wreduce t:$mul
techmap -map +/mul2dsp.v -map ${YOSYS_DSP_MAP_VERILOG} ${YOSYS_DSP_MAP_PARAMETERS} a:nodsp %n
select a:mul2dsp
setattr -unset mul2dsp
opt_expr -fine
wreduce
select -clear
chtype -set $mul t:$__soft_mul
proc

#########################
# Map adders
#########################
# Avoid merging any registers into DSP, reserve memory port registers first
techmap -map +/techmap.v -map ${YOSYS_ADDER_MAP_VERILOG}
opt -fast -nodffe -nosdff
opt_expr
opt_merge

#########################
# Run coarse synthesis
#########################
techmap
alumacc
share
opt -nodffe -nosdff
fsm
opt -fast -nodffe -nosdff
memory -nomap
opt_clean
opt -fast -full -nodffe -nosdff
techmap
opt -fast -nodffe -nosdff
clean

#########################
# Map logics to BRAMs
#########################
memory_libmap -lib ${YOSYS_BRAM_MAP_RULES}
techmap -map ${YOSYS_BRAM_MAP_VERILOG}
opt -fast -mux_undef -undriven -fine -nodffe -nosdff
memory_map
opt -undriven -fine -nodffe -nosdff

#########################
# Map flip-flops
#########################
dfflegalize -cell $_DFF_P_ 0
techmap -map +/adff2dff.v
opt_expr -mux_undef
simplemap
opt_expr
opt_merge
opt_dff -nodffe -nosdff
opt_clean
opt -nodffe -nosdff

#########################
# Map LUTs
#########################
abc -lut ${LUT_SIZE}

#########################
# Check and show statisitics
#########################
hierarchy -check
stat

#########################
# Output netlists
#########################
opt_clean -purge
write_blif ${OUTPUT_BLIF}
write_blif -param rewritten_${OUTPUT_BLIF}
write_verilog ${OUTPUT_VERILOG}
